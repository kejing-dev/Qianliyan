<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: state hooks driven over adb (QA screenshots per design state);
             usage in AGENTS.md ("Debug commands"). XML comments cannot hold a double hyphen. -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.embodit.jieyan.DEBUG" />
            </intent-filter>
        </receiver>
        <!-- installs the HTTP twin of the receiver (GET /debug on the assist server; broadcasts queue on a headset with the display off) -->
        <provider
            android:name=".debug.DebugInit"
            android:authorities="io.embodit.jieyan.debuginit"
            android:exported="false" />
    </application>
</manifest>
